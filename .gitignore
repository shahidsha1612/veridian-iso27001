# Secrets / credentials: never commit these
*.env
.env.*
*.pem
*.key
*.p12
*.pfx
**/credentials
**/credentials.json
*_rsa
*_rsa.pub
.aws/

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.tfvars.example
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
tfplan.out
*.tfplan

# Evidence artifacts: committed on purpose. There is no real evidence
# vault (no live AWS account); the signed manifest + signature in this
# repo IS the evidence that survives after any local infra is torn down.

# Internal-only build tracker, not published
automated-controls/

# LinkedIn write-ups: personal, not part of the public repo
docs/linkedin/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp

# Python bytecode cache
__pycache__/
*.pyc
